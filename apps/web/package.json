{
  "name": "@puxibot/web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "bundle:runner": "node ../../scripts/bundle-runner.mjs",
    "predev": "node ../../scripts/bundle-runner.mjs",
    "predev:demo": "node ../../scripts/bundle-runner.mjs",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "prebuild": "node ../../scripts/bundle-runner.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@puxibot/shared": "*",
    "lucide-react": "^1.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
