{
  "name": "@puxibot/runner",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "bin": {
    "puxibot": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json --noEmit && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@puxibot/shared": "*",
    "commander": "^15.1.0",
    "qrcode-terminal": "0.12.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
