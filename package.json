{
  "name": "puxibot",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:hub": "npm run dev -w @puxibot/hub",
    "dev:web": "npm run dev -w @puxibot/web",
    "build": "npm run build -w @puxibot/shared && npm run build -w @puxibot/web && npm run build -w @puxibot/runner",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:hub",
    "check:hub": "npm exec -w @puxibot/hub -- wrangler deploy --dry-run --outdir .wrangler/check",
    "db:migrate": "npm run db:migrate -w @puxibot/hub",
    "deploy": "node scripts/deploy-hub.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
